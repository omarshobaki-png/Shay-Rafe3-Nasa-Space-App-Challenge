const CAT_COLOR: Dictionary = {
	"core": Color("c9a227"), "power": Color("2b6fd6"), "comms": Color("e8ecff"), "science": Color("6dff8a"),
	"landing": Color("a0a8c0"), "robot": Color("ff9f43"), "return": Color("d8dce8"), "fuel": Color("8a94b8"),
	"protect": Color("4fd6ff"),
}
const PANEL: Vector2 = Vector2(24, 24)      # one solar panel
const YOKE: Vector2 = Vector2(9, 24)
const RAIL: Vector2 = Vector2(30, 4)
const WING_X: float = 47.0                  # inner edge of the first panel (the bus wall is at 38)
const WING_Y: float = -15.0                 # top of the front wing
const WING_BACK: Vector2 = Vector2(0, -11)  # the second wing sits behind the first, this much higher
const WING_COLS: int = 4
const RTG_STEP: float = 34.0                # RTGs chain outward along one boom
const CORE_UNITS: int = 8                   # units per core tank
const CORE_TANKS: int = 3
const SIDE_UNITS: int = 28                  # units per radial tank
const UNIT_PX: float = 3.0                  # barrel length per unit
const CORE_PITCH: float = 9.0               # collar between two stacked core tanks
const ASCENT_TOP: float = 35.0              # the dish mast stands this much higher on the ascent stage
const RAIL_X: float = 26.0                  # the payload rail starts here (left side: mirrored)
const RAIL_Y: float = 27.0
const SIDE_CLEAR: float = 27.0              # payloads move this far out past a radial tank
const HEAT_SINK: float = 17.0               # how deep the craft sits in the heat-shield bowl
const HIT: Dictionary = {                   # tighter hit boxes than the sprite, as [x, y, w, h] inside it
	"mag": [0, 0, 60, 24], "ka": [6, 0, 38, 30], "hga": [0, 0, 58, 36], "legs": [0, 34, 136, 23],
	"sunshade": [0, 0, 35, 69], "hull": [12, 39, 78, 16], "hull_front": [2, 14, 98, 25],
}

static var _tex: Dictionary = {}

static func _t(name: String) -> Texture2D:
	if not _tex.has(name):
		var path: String = "res://art/parts/%s.png" % name
		var t: Texture2D = null
		if ResourceLoader.exists(path):
			t = load(path)
		_tex[name] = t
	var out: Texture2D = _tex[name]
	return out

static func _spr(name: String) -> Rect2:
	match name:
		"solar", "solar_lite":
			return Rect2(Vector2.ZERO, PANEL)
		"yoke", "yoke_l":
			return Rect2(Vector2.ZERO, YOKE)
		"rail":
			return Rect2(Vector2.ZERO, RAIL)
		"heatshield_front":
			name = "heatshield"
	if not SPR.has(name):
		return Rect2(-6, -6, 12, 12)
	var a: Array = SPR[name]
	return Rect2(float(a[0]), float(a[1]), float(a[2]), float(a[3]))

## One placed sprite, moved by `off` from its own place on the ship. deco_of: it is a decoration of that part.
static func _put(out: Array, id: String, n: int, name: String, off: Vector2 = Vector2.ZERO, deco_of: String = "",
		flip: bool = false) -> Dictionary:
	var box: Rect2 = _spr(name)
	box.position += off
	var hit: Rect2 = box
	if HIT.has(name):
		var h: Array = HIT[name]
		hit = Rect2(box.position + Vector2(float(h[0]), float(h[1])), Vector2(float(h[2]), float(h[3])))
	var cat: String = String(Data.PARTS[id]["cat"]) if Data.PARTS.has(id) else "landing"
	var it: Dictionary = {"id": id, "n": n, "tex": _t(name), "pos": box.position, "flip": flip, "rect": hit,
		"color": CAT_COLOR.get(cat, Color.WHITE), "box": box}
	if deco_of != "":
		it["deco"] = true
		it["owner"] = deco_of
		if not HIT.has(name):
			it["rect"] = Rect2(box.position, Vector2.ZERO)
	out.append(it)
	return it

static func _cnt(build: Dictionary, id: String) -> int:
	if not Data.PARTS.has(id):
		return 0
	return clampi(int(build.get(id, 0)), 0, int(Data.PARTS[id]["max"]))

## Units in each tank: [core 0, core 1, core 2, right, left].
static func _tanks(units: int) -> Array[int]:
	var core: int = mini(units, CORE_UNITS * CORE_TANKS)
	var side: int = units - core
	var out: Array[int] = []
	for i: int in CORE_TANKS:
		out.append(clampi(core - i * CORE_UNITS, 0, CORE_UNITS))
	out.append(mini((side + 1) / 2, SIDE_UNITS))
	out.append(mini(side / 2, SIDE_UNITS))
	return out

static func layout(build: Dictionary) -> Array:
	var tanks: Array[int] = _tanks(_cnt(build, "prop"))

	# ---- propellant: core stack and radial tanks
	var stack: float = 0.0    # how far the core tanks push everything under the bus down
	var core_items: Array = []
	for i: int in CORE_TANKS:
		if tanks[i] > 0:
			_put(core_items, "prop", i, "core_%d" % tanks[i], Vector2(0, stack))
			stack += tanks[i] * UNIT_PX + CORE_PITCH
	core_items.reverse()      # lower tanks first: each tank covers the top of the one under it
	var side_items: Array = []
	for s: int in 2:
		if tanks[3 + s] > 0:
			_put(side_items, "prop", 3 + s, "side_%d%s" % [tanks[3 + s], "_l" if s == 1 else ""])

	# ---- payloads on the rail: rover right, big rover left, drone left (right if the big rover is there)
	var pay: Array = []
	var cursor: Array[float] = [RAIL_X + (SIDE_CLEAR if tanks[3] > 0 else 0.0), RAIL_X + (SIDE_CLEAR if tanks[4] > 0 else 0.0)]
	var plan: Array = []      # [id, side (0 right, 1 left)]
	if _cnt(build, "rover") > 0:
		plan.append(["rover", 0])
	if _cnt(build, "rover_big") > 0:
		plan.append(["rover_big", 1])
	if _cnt(build, "drone") > 0:
		plan.append(["drone", 0 if _cnt(build, "rover_big") > 0 else 1])
	for pl: Array in plan:
		var pid: String = pl[0]
		var side: int = pl[1]
		var home: Rect2 = _spr(pid)
		var x: float = cursor[side] if side == 0 else -cursor[side] - home.size.x
		var rx: float = RAIL_X     # bridge from the bus to a payload that sits further out
		while rx < cursor[side]:
			_put(pay, "rail", 0, "rail", Vector2(rx if side == 0 else -rx - RAIL.x, RAIL_Y), pid)
			rx += RAIL.x - 2.0
		_put(pay, pid, 0, pid, Vector2(x - home.position.x, 0), "", (home.position.x > 0.0) != (side == 0))
		cursor[side] += home.size.x - 1.0

	# ---- engine and landing gear follow the stack
	var gear: Array = []
	var legs: Array = []
	_put(gear, "engine", 0, "engine", Vector2(0, maxf(0.0, stack - 3.0)), "prop" if stack > 0.0 else "bus")
	if _cnt(build, "airbags") > 0:     # packed around the engine, behind the last tank
		_put(gear, "airbags", 0, "airbags", Vector2(0, stack + 4.0))
	if _cnt(build, "legs") > 0:
		_put(legs, "legs", 0, "legs", Vector2(0, stack))

	var hull: Array = []
	if _cnt(build, "hull") > 0:
		_put(hull, "hull", 0, "hull")
	var bottom: float = 30.0
	for arr: Array in [core_items, side_items, pay, gear, legs, hull]:
		for it: Dictionary in arr:
			var b: Rect2 = it["box"]
			bottom = maxf(bottom, b.end.y)
	var out: Array = []
	var has_heat: bool = _cnt(build, "heatshield") > 0
	var heat_off: Vector2 = Vector2(0, bottom - HEAT_SINK - _spr("heatshield").position.y)
	if has_heat:
		_put(out, "heatshield", 0, "heatshield", heat_off)
	if _cnt(build, "sunshade") > 0:
		_put(out, "sunshade", 0, "sunshade")
	out.append_array(hull)

	# ---- solar wings: panels alternate right / left; the second wing of a side sits behind the first
	var n_solar: int = _cnt(build, "solar")
	var wing_back: Array = []
	var wing_front: Array = []
	for k: int in n_solar + _cnt(build, "solar_lite"):
		var lite: bool = k >= n_solar
		var sid: String = "solar_lite" if lite else "solar"
		var left: bool = k % 2 == 1
		var back: bool = k / 2 >= WING_COLS
		var col: int = (k / 2) % WING_COLS
		var pos: Vector2 = Vector2(WING_X + col * PANEL.x if not left else -WING_X - (col + 1) * PANEL.x, WING_Y)
		if back:
			pos += WING_BACK
		var wing: Array = wing_back if back else wing_front
		if col == 0:
			_put(wing, "yoke", (2 if back else 0) + (1 if left else 0), "yoke_l" if left else "yoke",
				Vector2(-WING_X if left else WING_X - YOKE.x, pos.y), sid)
		_put(wing, sid, k - n_solar if lite else k, sid, pos)

	# ---- back to front
	out.append_array(wing_back)
	out.append_array(pay)
	out.append_array(side_items)
	out.append_array(gear)
	out.append_array(core_items)
	out.append_array(legs)
	_put(out, "bus", 0, "bus")
	if _cnt(build, "shield") > 0:
		_put(out, "shield", 0, "shield")
	if not hull.is_empty():
		_put(out, "hull", 0, "hull_front", Vector2.ZERO, "hull")
	var n_batt: int = _cnt(build, "battery")
	for j: int in n_batt + _cnt(build, "battery_hi"):
		if j < n_batt:
			_put(out, "battery", j, "battery_%d" % j)
		else:
			_put(out, "battery_hi", j - n_batt, "battery_hi_%d" % j)
	for r: int in _cnt(build, "recorder"):
		_put(out, "recorder", r, "recorder_%d" % r)
	for fid: String in ["camera", "spectro", "dust", "drill", "mag"]:
		if _cnt(build, fid) > 0:
			_put(out, fid, 0, fid)
	for g: int in _cnt(build, "rtg"):
		var gl: bool = g % 2 == 1
		_put(out, "rtg", g, "rtg_l" if gl else "rtg", Vector2((-1.0 if gl else 1.0) * RTG_STEP * (g / 2), 0))
	out.append_array(wing_front)
	var has_ascent: bool = _cnt(build, "ascent") > 0
	for tid: String in ["ascent", "mga", "chute", "hga", "lga", "ka"]:
		if _cnt(build, tid) > 0:
			_put(out, tid, 0, tid, Vector2(0, -ASCENT_TOP) if (tid == "hga" and has_ascent) else Vector2.ZERO)
	if has_heat:
		_put(out, "heatshield_front", 0, "heatshield_front", heat_off, "heatshield")
	return out

## Where one more `id` would go. {} when the part cannot be added (at its maximum).
## "node" is the attach point to light up; "rect" is where the sprite will sit.
static func next_slot(build: Dictionary, id: String) -> Dictionary:
	if not Data.PARTS.has(id):
		return {}
	var have: int = int(build.get(id, 0))
	if have >= int(Data.PARTS[id]["max"]):
		return {}
	var after: Dictionary = build.duplicate()
	after[id] = have + 1
	var want_n: int = have
	if id == "prop":            # the tank that takes the new unit
		var a: Array[int] = _tanks(have)
		var b: Array[int] = _tanks(have + 1)
		for i: int in b.size():
			if b[i] != a[i]:
				want_n = i
	for it: Dictionary in layout(after):
		if it["id"] != id or int(it["n"]) != want_n or it.has("deco"):
			continue
		var box: Rect2 = it["box"]
		var c: Vector2 = box.get_center().floor()
		var node: Vector2 = c
		match id:
			"prop":
				node = Vector2(c.x, box.end.y - (9.0 if want_n < CORE_TANKS else 12.0))
			"solar", "solar_lite", "rtg":
				node = Vector2(box.position.x if c.x > 0.0 else box.end.x - 1.0, c.y)
			"ascent", "hga", "mga", "lga", "chute":
				node = Vector2(c.x, box.end.y - 2.0)
			"ka":
				node = Vector2(box.position.x + 4.0, box.end.y - 4.0)
			"mag":
				node = Vector2(box.end.x - 4.0, box.end.y - 4.0)
			"legs", "airbags", "heatshield":
				node = Vector2(0, box.position.y + 6.0)
			"sunshade":
				node = Vector2(box.end.x - 12.0, box.position.y + 43.0)   # the upper standoff root on the bus wall
			"hull":
				node = Vector2(0, box.position.y + 18.0)
			"rover", "rover_big", "drone":
				node = Vector2(box.position.x + 2.0 if c.x > 0.0 else box.end.x - 3.0, box.position.y + 1.0)
		return {"node": node, "rect": box, "pos": it["pos"], "tex": it["tex"], "flip": it["flip"]}
	return {}

static func bounds(build: Dictionary) -> Rect2:
	var r: Rect2 = _spr("bus")
	for it: Dictionary in layout(build):
		var b: Rect2 = it["box"]
		r = r.merge(b)
	return r

## nudge = {"id": part id, "box": Rect2, "off": Vector2} draws the sprites of that part which touch `box`
## moved by `off` (the builder slides a new part into place with it).
static func draw(ci: CanvasItem, origin: Vector2, build: Dictionary, mod: Color = Color.WHITE, highlight_id: String = "",
		nudge: Dictionary = {}) -> void:
	var o: Vector2 = origin.floor()
	for it: Dictionary in layout(build):
		var c: Color = mod
		if highlight_id != "" and (it["id"] == highlight_id or it.get("owner", "") == highlight_id):
			c = Color(mod.r * 1.35, mod.g * 1.35, mod.b * 1.35, mod.a)
		var tex: Texture2D = it["tex"]
		var p: Vector2 = it["pos"]
		var box: Rect2 = it["box"]
		if not nudge.is_empty() and (it["id"] == nudge["id"] or it.get("owner", "") == nudge["id"]) and box.intersects((nudge["box"] as Rect2).grow(2.0)):
			p += Vector2(nudge["off"])
			box.position += Vector2(nudge["off"])
		if tex == null:
			ci.draw_rect(Rect2(o + box.position, box.size), Color(it["color"]) * c)
		elif it["flip"]:
			ci.draw_texture_rect(tex, Rect2(o + p, Vector2(-tex.get_width(), tex.get_height())), false, c)
		else:
			ci.draw_texture(tex, o + p, c)

static func icon(id: String) -> Texture2D:
	return _t("icon_" + id)

static func launcher(rocket_id: String) -> Texture2D:
	return _t("lv_" + rocket_id)

static func launcher_icon(rocket_id: String) -> Texture2D:
	return _t("lv_icon_" + rocket_id)
